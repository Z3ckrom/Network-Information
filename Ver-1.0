def get_ip_address():
    try:
        result = subprocess.run(['ipconfig'], capture_output=True, text=True)

        # Find the IPv4 Address
        match = re.search(
            r'IPv4 Address[.\s]*:\s*([\d.]+)',
            result.stdout)

        return match.group(1) if match else "Not Connected"

    except Exception as e:
        return f"Error: {e}"

def get_gateway():
    try:
        result = subprocess.run(['ipconfig'], capture_output=True, text=True)

        # Find the default gateway
        match = re.search(
            r'Default Gateway[.\s]*:\s*([\d.]+)',
            result.stdout)

        return match.group(1) if match else "No Gateway Found"

    except Exception as e:
        return f"Error: {e}"

def ping_test(host):
    try:
        result = subprocess.run(['ping', '-n', '4', host], capture_output=True, text=True, timeout=15)

        return result.stdout if result.returncode == 0 else "Ping Failed"
    except subprocess.TimeoutExpired:
        return "Error: Ping timed out"
    except Exception as e:
        return f"Error: {e}"

    # Asks user what IP or hostname to ping
    host = input("Enter the IP address or hostname: ")
    print(ping_test(host))


def get_public_ip():
    try:
        response = requests.get('https://api.ipify.org')
        if response.status_code == 200:
            return response.text
        return "Unable to fetch public IP"
    except Exception as e:
        return f"Error: {e}"

def get_bandwidth(interface=None):
    try:
        command = [
            "powershell",
            "-NoProfile",
            "-Command",
            "Get-NetAdapter | Select-Object Name, InterfaceDescription, Status, LinkSpeed | ConvertTo-Csv -NotypeInformation"]
        
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=10)

        if result.returncode != 0:

            return result.stderr.strip() or "Unable to get adapter speed"

        lines = result.stdout.strip().splitlines()

        if len(lines) < 2:

            return "No network adapters found"

        # Display all adapters if no interface is specified

        if interface is None:

            return "\n".join(lines)

        # Find adapter by name or interface description

        import csv

        from io import StringIO

        adapters = list(csv.DictReader(StringIO(result.stdout)))

        for adapter in adapters:

            if (

                adapter["Name"].lower() == interface.lower()

                or adapter["InterfaceDescription"].lower() == interface.lower()

            ):

                return adapter["LinkSpeed"]

        return f"Interface '{interface}' not found"

    except Exception as e:

        return f"Error: {e}"

print(get_bandwidth())


def get_lldp_info():
    def get_lldp_info():

        executable = shutil.which("lldpctl")

    if executable is None:

        return (

            "LLDP tool not found",

            "Install or configure a Windows-compatible LLDP utility"

        )

    try:

        result = subprocess.run(

            [executable],

            capture_output=True,

            text=True,

            timeout=10

        )

        if result.returncode != 0:

            return (

                result.stderr.strip() or "Unable to retrieve LLDP data",

                "Not available"

            )

        port_id = "Not available"

        switch_name = "Not available"

        for line in result.stdout.splitlines():

            line = line.strip()

            if line.startswith(("PortID:", "Port ID:")):

                port_id = line.split(":", 1)[1].strip()

            elif line.startswith("SysName:") or line.startswith("System Name:"):

                switch_name = line.split(":", 1)[1].strip()

        return port_id, switch_name

    except subprocess.TimeoutExpired:

        return "LLDP request timed out", "Not available"

    except Exception as e:

        return f"Error: {e}", "Not available"


